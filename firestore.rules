rules_version = '2';

// Reglas de seguridad de Firestore para BankPick.
// Principio: denegar por defecto y permitir solo lectura de los documentos
// cuyo dueño es el usuario autenticado. Los datos bancarios (cuentas,
// tarjetas, movimientos) son de SOLO LECTURA desde el cliente: cualquier
// escritura debe hacerla un backend de confianza (Admin SDK / Cloud Functions).
//
// NOTA: estas reglas asumen que los documentos guardan `user_id == auth.uid`.
// Si hoy `user_id` guarda otro identificador (p. ej. el email), hay que
// migrar los datos o ajustar la comparación antes de publicarlas.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    match /users/{id} {
      allow read: if isSignedIn() && request.auth.uid == id;
      allow write: if false;
    }

    match /accounts/{id} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /cards/{id} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /movs/{id} {
      allow read: if isOwner();
      allow write: if false;
    }

    // Catálogos públicos de la app (solo lectura para usuarios autenticados).
    match /catalogs/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
